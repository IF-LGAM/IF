<Layouts.app flash={@flash} current_user={@current_user}>
  <div class="max-w-2xl mx-auto space-y-8 py-8">
    <%= if @current_user do %>
      <%!-- Écran de confirmation de création / connexion (IF-23) --%>
      <div class="card bg-base-100 shadow-xl border border-base-200">
        <div class="card-body p-8 space-y-6 text-center">
          <div class="inline-flex items-center justify-center size-16 rounded-full bg-success/15 text-success mx-auto shadow-sm">
            <.icon name="hero-check" class="size-8" />
          </div>

          <div class="space-y-2">
            <h1 class="text-3xl font-extrabold text-base-content">
              Bienvenue, {@current_user.name} !
            </h1>
            <p class="text-base text-base-content/70">
              Votre compte est actif et votre session est correctement initialisée.
            </p>
          </div>

          <div class="bg-base-200/60 rounded-xl p-4 text-left divide-y divide-base-200 text-sm">
            <div class="py-2.5 flex justify-between items-center">
              <span class="text-base-content/60 font-medium">Nom / Pseudo</span>
              <span class="font-semibold text-base-content">{@current_user.name}</span>
            </div>
            <div class="py-2.5 flex justify-between items-center">
              <span class="text-base-content/60 font-medium">Adresse Email</span>
              <span class="font-mono text-base-content">{@current_user.email}</span>
            </div>
            <div class="py-2.5 flex justify-between items-center">
              <span class="text-base-content/60 font-medium">Statut de la session</span>
              <span class="badge badge-success badge-sm gap-1">
                <.icon name="hero-check" class="size-3" /> Connecté
              </span>
            </div>
          </div>

          <div class="pt-4 flex flex-col sm:flex-row gap-3 justify-center items-center">
            <.link
              navigate={~p"/wallets/new"}
              id="home-create-wallet-btn"
              class="btn btn-primary w-full sm:w-auto gap-2"
            >
              <.icon name="hero-plus" class="size-5" />
              <span>Créer un porte-monnaie</span>
            </.link>

            <.link
              navigate={~p"/wallets"}
              id="home-my-wallets-btn"
              class="btn btn-outline w-full sm:w-auto gap-2"
            >
              <.icon name="hero-wallet" class="size-5" />
              <span>Mes porte-monnaies</span>
            </.link>

            <.link
              href={~p"/users/log_out"}
              method="delete"
              id="disconnect-user-btn"
              class="btn btn-ghost btn-error w-full sm:w-auto gap-2"
            >
              <.icon name="hero-arrow-right-start-on-rectangle" class="size-5" />
              <span>Se déconnecter</span>
            </.link>
          </div>
        </div>
      </div>
    <% else %>
      <%!-- Page d'accueil publique non connecté --%>
      <div class="card bg-base-100 shadow-xl border border-base-200">
        <div class="card-body p-8 space-y-6 text-center">
          <div class="inline-flex items-center justify-center size-16 rounded-2xl bg-primary/10 text-primary mx-auto shadow-sm">
            <img src={~p"/images/logo.svg"} width="40" />
          </div>

          <div class="space-y-2">
            <h1 class="text-3xl font-extrabold text-base-content">
              Les Bons Comptes
            </h1>
            <p class="text-base text-base-content/70">
              Gérez vos finances partagées simplement et en toute transparence.
            </p>
          </div>

          <div class="pt-4 flex flex-col sm:flex-row gap-4 justify-center items-center">
            <.link navigate={~p"/sign-up"} class="btn btn-primary w-full sm:w-auto gap-2">
              <.icon name="hero-user-plus" class="size-5" />
              <span>Créer un compte</span>
            </.link>

            <.link navigate={~p"/sign-in"} class="btn btn-outline w-full sm:w-auto gap-2">
              <span>Se connecter</span>
            </.link>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</Layouts.app>
